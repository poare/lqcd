<?xml version="1.0"?>
<!--
  NPR momentum-fraction measurement, one configuration per run.
-->
<chroma>
<Param>
  <InlineMeasurements>
    <elem>
      <Name>NPR_MOMFRAC</Name>
      <Frequency>1</Frequency>
      <Param>
        <version>1</version>

        <!-- Point source location. If unspecified, picks a random pt source. -->
        <tsrc>14 6 7 37</tsrc>

        <ksq_cut>20</ksq_cut>
        <h_cut>0.5</h_cut>
        <all_pos>true</all_pos>

        <!-- Explicit mode list, for testing against known values. -->
        <!--
        <mom_list>
          <elem>1 1 1 1</elem>
          <elem>3 0 0 0</elem>
        </mom_list>
        -->

        <!-- Momentum twist. (0,0,0,1/2) for antiperiodic time.-->
        <bvec>0 0 0 0.5</bvec>

        <output_type>TEXT</output_type>
        <output_file>./cfg1600_chroma.txt</output_file>

        <!-- Replace this block to change the action. -->
        <FermionAction>
          <FermAct>CLOVER</FermAct>
          <Mass>-0.2450</Mass>
          <clovCoeff>1.2493</clovCoeff>
          <AnisoParam>
            <anisoP>false</anisoP><t_dir>3</t_dir><xi_0>1</xi_0><nu>1</nu>
          </AnisoParam>
          <FermionBC>
            <FermBC>SIMPLE_FERMBC</FermBC>
            <boundary>1 1 1 -1</boundary>
          </FermionBC>
        </FermionAction>

        <InvertParam>
          <invType>CG_INVERTER</invType>
          <RsdCG>1.0e-8</RsdCG>
          <MaxCG>10000</MaxCG>
        </InvertParam>

      </Param>
      <NamedObject>
        <gauge_id>default_gauge_field</gauge_id>
      </NamedObject>
    </elem>

  </InlineMeasurements>
  <nrow>16 16 16 48</nrow>
</Param>

<RNG><Seed><elem>11</elem><elem>11</elem><elem>11</elem><elem>0</elem></Seed></RNG>
<Cfg>
  <cfg_type>SCIDAC</cfg_type>
  <cfg_file>/home/poare/Dropbox/research/gf-pdf-npr/npr_conv_tests/cl3_16_48_b6p1_m0p2450_cfg_1600.lime</cfg_file>
</Cfg>
</chroma>
