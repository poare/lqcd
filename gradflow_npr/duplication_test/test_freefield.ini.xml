<?xml version="1.0"?>
<!-- Free-field test: unit gauge field, so F_munu = 0 and the clover term
     vanishes. clovCoeff is set to 0 explicitly anyway, to remove one
     variable. Small volume, three momenta, runs in seconds. -->
<chroma>
<Param>
  <InlineMeasurements>
    <elem>
      <Name>NPR_MOMFRAC</Name>
      <Frequency>1</Frequency>
      <Param>
        <version>1</version>
        <tsrc>1 2 3 5</tsrc>
        <mom_list>
          <elem>1 1 1 1</elem>
          <elem>1 1 1 2</elem>
          <elem>2 1 0 1</elem>
        </mom_list>
        <bvec>0 0 0 0</bvec>
        <output_type>TEXT</output_type>
        <output_file>./freefield.txt</output_file>
        <FermionAction>
          <FermAct>CLOVER</FermAct>
          <Mass>-0.2450</Mass>
          <clovCoeff>0.0</clovCoeff>
          <AnisoParam>
            <anisoP>false</anisoP><t_dir>3</t_dir><xi_0>1</xi_0><nu>1</nu>
          </AnisoParam>
          <FermionBC>
            <FermBC>SIMPLE_FERMBC</FermBC>
            <boundary>1 1 1 1</boundary>
          </FermionBC>
        </FermionAction>
        <InvertParam>
          <invType>CG_INVERTER</invType>
          <RsdCG>1.0e-14</RsdCG>
          <MaxCG>10000</MaxCG>
        </InvertParam>
      </Param>
      <NamedObject>
        <gauge_id>default_gauge_field</gauge_id>
      </NamedObject>
    </elem>
  </InlineMeasurements>
  <nrow>4 4 4 8</nrow>
</Param>
<RNG><Seed><elem>11</elem><elem>11</elem><elem>11</elem><elem>0</elem></Seed></RNG>
<Cfg><cfg_type>UNIT</cfg_type><cfg_file>dummy</cfg_file></Cfg>
</chroma>
