#!/bin/bash -l
#SBATCH --job-name=qhmc-mg
#SBATCH --nodes=36
#SBATCH --ntasks-per-node=8
#SBATCH --cpus-per-task=7
#SBATCH --gpus-per-node=8
#SBATCH -p extended
#SBATCH --time=4:00:00
#SBATCH --account=phy157_dwf
#SBATCH --gpu-bind=none
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH -S 0
#SBATCH --exclude=frontier06752,frontier02678

##############################################################################
# Frontier quenched HMC with the PVdagM multigrid as passenger, 48^3x96: stage 1
# of the test plan (research hub, projects/multigrid,
# writeups/deflation_basis_evolution).  One trajectory at tau 0.2, N 20, Mode
# recoarsen, from the saved basis, Nrhs 1, a solve every 5 MD steps.  Pass: the
# first solve and the QHMC-REBUILD-CHECK solve both take 60 iterations, the 4 MD
# solves converge, and dH matches trajectory 0 of 5800475 (-1.80537).
#
# Stage 1b (5801016 stalled at the first MD solve, t_MD 0.05): a solve at every
# MD step, capped at 13 restarts of 12 steps (156 outer iterations), with the Galerkin certificate and
# null_resid after each rebuild.  Only the first 5 steps matter; the 28 min
# timeout ends the run.  Smooth degradation from step 1 means real staleness; a
# jump at step 1 or a failed certificate means a bug.
#
# Stage 2: SolveEvery 5, MaxIterations 1000, Ntraj 15, SolveTraj 0 1 2 3 4 5 7 8 10 14 (the first 10 accepted
# trajectories of 5800475), Mode frozen or recoarsen, --time 2:00:00.
#
# Stage 2b (replaces stage 2, 5801401 stalled by t_MD 0.04): Mode refresh, one
# sloppy pass per vector at every MD step, then a rebuild.  Pass: all 20 solves
# stay near 60 iterations, and dH matches trajectory 0 of 5800475 (-1.80537).
#
# Stage 2c (5801931 held 60-65 iterations to step 8, capped from step 14):
# RefreshPasses 3, otherwise as stage 2b.
#
# Stage 3 (5819892: 3 refresh passes reached 150 iterations by step 20): Mode
# perturbative, a first-order update and a rebuild at every MD step.  Pass: dH
# matches -1.80537; the staleness curve compares with 5801401, 5801931, 5819892.
#
# Stage 3b (5833066 held 57-64 iterations to step 11, but the update took 437 s
# of 530 s per step at CorrTol 1e-2, 17 GCR steps per batch): CorrTol 0.1, which
# 5833066's residual history reaches in 4 steps.  CORRTOL overrides.
#
# Stage 2d (best case for the sloppy Krylov refresh): Mode refresh, 3 passes of
# 100 GCR steps per vector at every MD step (RefreshMaxOuter 10, RefreshTol
# small enough that the cap governs).  About 3 h, inside the extended queue's
# 4 h set above (5835659):
#   sbatch --export=ALL,MODE=refresh,REFRESHPASSES=3,REFRESHMAXOUTER=10,REFRESHTOL=1e-6 run_hmc_multigrid_quenched_frontier.job
#
# Stage 2e (5835659 was worse than 3 passes of 10 steps: the passes drive every
# vector to the same lowest modes): the same, orthonormalising after each pass:
#   sbatch --export=ALL,MODE=refresh,REFRESHPASSES=3,REFRESHMAXOUTER=10,REFRESHTOL=1e-6,REFRESHORTHO=1 run_hmc_multigrid_quenched_frontier.job
#
# Stage 3c (5834878 at CorrTol 0.1 went stale and ran out of device memory at
# step 11): CorrTol 3e-2, with the QHMC-MEM line logging free device memory:
#   sbatch --export=ALL,MODE=perturbative,CORRTOL=3e-2 run_hmc_multigrid_quenched_frontier.job
#
# Stage 3d (5839214 ran out of device memory inside step 9's update; free
# memory was flat between steps, so a transient peak): CorrTol 1e-2 again, with
# no copy of the basis in the update and batches of 6, about 12 GB less:
#   sbatch --export=ALL,MODE=perturbative,CORRTOL=1e-2,CORRNRHS=6 run_hmc_multigrid_quenched_frontier.job
#
# Stage 2f, the A^{-k} scan (5835659 and 5839215 degraded from step 1, where the
# field has barely moved): at a field held almost fixed, tau 2e-4 (eps 1e-5),
# each MD step applies ONE more round of inverse iteration as in generation
# (GCR(10,10) to 5e-4, at most 30 restarts), then rebuilds and solves.  The
# loaded basis is k = 3, MD step n is k = 3+n.  Outer cap 240 so that a rise
# past 156 shows; about 3.5 h; dH is meaningless here:
#   sbatch --export=ALL,MODE=refresh,REFRESHPASSES=1,REFRESHMAXOUTER=30,REFRESHTOL=5e-4,TRAJL=0.0002,OUTERMAXIT=20 run_hmc_multigrid_quenched_frontier.job
#
# Stage 2g, the A^{-k} scan from k = 0 (5843569 rose monotonically from 59 at
# k = 3; is 3 the optimum or just the smallest k tested?): as stage 2f, but
# NOISEBASIS=1 replaces the loaded basis by Gaussian noise, so the solve before
# the MD is k = 0 and MD step n is k = n, up to 20.  k = 3 repeats 5843569's 59
# from a different noise draw.  The k = 0 solve will most likely run to the
# 240 cap.  About 3.3 h at 300 steps per round:
#   sbatch --export=ALL,MODE=refresh,REFRESHPASSES=1,REFRESHMAXOUTER=30,REFRESHTOL=5e-4,TRAJL=0.0002,OUTERMAXIT=20,NOISEBASIS=1 run_hmc_multigrid_quenched_frontier.job
# The k x round-budget scan around it (REFRESHMAXOUTER restarts of 10 steps,
# REFRESHTOL), at either MG parameter set (MGSET p0 or dense3, below), is
# submit_ak_scan.sh.
#
# Stage 4a, the one-step epsilon scan: SCAN="mode:trajl/mode:trajl/..." runs
# one srun per entry inside this allocation, each from the saved basis with
# the same seeds, its own params file and log
# (MG_QHMC_<jobid>_<mode>_eps<trajl>.log).  MDSTEPS and every other knob are
# shared.  TIMEOUT is per entry; --time must cover them all.
# submit_eps_scan.sh.
#
# Control, the same script (the defaults are stage 3):
#   sbatch --export=ALL,MODE=control,RUNMG=0 run_hmc_multigrid_quenched_frontier.job
#
# Derived from run_pvdagm_multigrid_frontier.job (same partition, environment,
# select_gpu wrapper and --device-mem 32000).  The step-1 version of this script
# (generate and save the basis, solves, one trajectory) is lqcd e9f2e86.
##############################################################################

MODE=${MODE:-perturbative}
RUNMG=${RUNMG:-1}
SOLVEEVERY=${SOLVEEVERY:-1}
CORRTOL=${CORRTOL:-1e-1}
CORRNRHS=${CORRNRHS:-12}                 # must divide the basis size, 60
CORRMAXRESTARTS=${CORRMAXRESTARTS:-4}    # restarts of Outer.Nstep per correction batch
CORRPRECON=${CORRPRECON:-mg}             # mg: mrhs GCR with the V-cycle; none: plain GCR per vector
CORRKRYLOVNSTEP=${CORRKRYLOVNSTEP:-10}   # CORRPRECON none: GCR(n,n), CORRMAXRESTARTS restarts
DIAGEVERY=${DIAGEVERY:-0}                # >0: QHMC-DIAG basis diagnostics after setup and every DIAGEVERY MD steps
DIAGTEST=${DIAGTEST:-10}                 # test vectors from fresh noise (about 25 s each at p0); 0: none
DIAGTESTREGEN=${DIAGTESTREGEN:-0}        # 1: new test vectors at every diagnostic (moving field)
DIAGREFERENCE=${DIAGREFERENCE:-1}        # 1: the starting basis, kept in fp32, is the reference
TRAJL=${TRAJL:-0.2}                      # trajectory length
MDSTEPS=${MDSTEPS:-20}                   # MD steps per trajectory; eps = TRAJL/MDSTEPS
REFRESHTOL=${REFRESHTOL:-0.1}
REFRESHPASSES=${REFRESHPASSES:-3}
REFRESHMAXOUTER=${REFRESHMAXOUTER:-1}
REFRESHORTHO=${REFRESHORTHO:-0}
REFRESHKICK=${REFRESHKICK:-0}
NOISEBASIS=${NOISEBASIS:-0}              # 1: start from Gaussian noise (k = 0 of the A^{-k} scan)
OUTERMAXIT=${OUTERMAXIT:-13}             # restarts of the outer GCR, 12 steps each
TIMEOUT=${TIMEOUT:-235m}                 # keep a few minutes under --time
SCAN=${SCAN:-}                           # stage 4a: "mode:trajl/..." one srun per entry

# MG parameter set.  p0: Peter's P0 cell of pvdagm-mixed-precision (5531534),
# with fine shift 0.1 and Outer.Mmax 4 as in 5783904; every run before 2026-11-04.
# dense3: the defaults of Example_pvdagm_mrhs_3level_dense.cc, where Peter tuned
# the setup in July (supercoarse Block2 to the [3,6,8,8] dense floor).  The same
# CreateSubspaceGCR basis either way.  Outer.Nstep differs (12 vs 8), so the
# outer cap is OUTERMAXIT x Nstep iterations.
MGSET=${MGSET:-p0}
case $MGSET in
  p0)     BLOCK1="2 2 3 3"; BLOCK2="4 4 2 4"
          FSHIFT=0.1; FNSTEP=6;  FMMAX=4
          CSHIFT=2.0; CNSTEP=2;  CMMAX=2
          CTOL=0.05;  CORDER=200; CSMMAX=8
          OMMAX=4;    ONSTEP=12 ;;
  dense3) BLOCK1="2 2 2 2"; BLOCK2="8 4 3 6"
          FSHIFT=0.1; FNSTEP=16; FMMAX=16
          CSHIFT=0.1; CNSTEP=4;  CMMAX=4
          CTOL=0.03;  CORDER=200; CSMMAX=16
          OMMAX=8;    ONSTEP=8 ;;
  *)      echo "unknown MGSET $MGSET -- stopping"; exit 1 ;;
esac
elems () { for x in $1; do printf "<elem>%s</elem>" $x; done; }

# --- edit these two ---
GRIDROOT=${GRIDROOT:-/ccs/home/poare/GridPoare}  # fork by default; --export GRIDROOT=... overrides
BUILD=$GRIDROOT/build-rocm72                     # the build directory configured below

source $GRIDROOT/systems/Frontier/sourceme-rocm7.2.sh

SAVE=/lustre/orion/phy157/proj-shared/phy157_dwf/poare/subspaces/ckpoint_lat.1000_nb60.scidac
CONFIG=/lustre/orion/phy157/proj-shared/phy157_dwf/paboyle/configs/ckpoint_lat.1000   # ~/ckpoint_lat.1000 links here
BIN=$BUILD/examples/Example_hmc_multigrid_quenched_frontier
COMPACT=${COMPACT:-/ccs/home/poare/lqcd/multigrid/python_scripts/qhmc_compact.py}   # writes $LOGDIR/mghmc_compact/<log>_compact.log
LOGDIR=/ccs/home/poare/lqcd/multigrid/logs/ckpoint_lat.1000

for f in $CONFIG $BIN $SAVE; do
  [ -r $f ] || { echo "NOT READABLE: $f -- stopping"; exit 1; }
done

mkdir -p $LOGDIR
LOG=$LOGDIR/MG_QHMC_${SLURM_JOB_ID}.log
PARAMS=$LOGDIR/MG_QHMC_${SLURM_JOB_ID}.params.xml
( cd $GRIDROOT && echo "Grid $(git rev-parse HEAD) $(git status --short | wc -l) modified" )

# Never strip this wrapper: distinct-GCD binding, NUMA locality, SDMA peer copies.
cat << EOF > select_gpu
#!/bin/bash
export GPU_MAP=(0 1 2 3 7 6 5 4)
export NUMA_MAP=(3 3 1 1 2 2 0 0)
export GPU=\${GPU_MAP[\$SLURM_LOCALID]}
export NUMA=\${NUMA_MAP[\$SLURM_LOCALID]}
export HIP_VISIBLE_DEVICES=\$GPU
unset ROCR_VISIBLE_DEVICES
if [ \$SLURM_PROCID = "0" ]; then echo \$*; fi
exec numactl -m \$NUMA -N \$NUMA \$*
EOF
chmod +x ./select_gpu

export OMP_NUM_THREADS=7
ulimit -c 0                             # no 22 GB GPU core dumps
export FI_MR_CACHE_MONITOR=kdreg2
export FI_HMEM_ROCR_USE_DMABUF=0        # avoidance of the CXI NO_TRANSLATION fault at Nrhs >= 12
export MPICH_GPU_SUPPORT_ENABLED=1
export MPICH_SMP_SINGLE_COPY_MODE=CMA
export MPICH_OFI_NIC_POLICY=GPU
export GRID_ALLOC_NCACHE_LARGE=64

module load libfabric

OPTS="--accelerator-threads 8 --shm 4096 --shm-mpi 0 --device-mem 32000 --comms-overlap"
vol=48.48.48.96
MPI_GEOM=3.6.4.4

# Multigrid block: the MGSET parameter set above.  Every field of the driver's
# QuenchedHMCDriverParams and of PVdagMMultiGridParams.h must appear here: a
# missing numeric tag reads as '' and aborts the run (5824735, 5824743), and a
# missing string tag silently reads as empty.
write_params () {
cat << EOF > $PARAMS
<?xml version="1.0"?>
<grid>
  <QuenchedHMCDriver>
    <Ls>24</Ls>
    <Mass>0.00078</Mass>
    <M5>1.8</M5>
    <MobiusB>1.5</MobiusB>
    <MobiusC>0.5</MobiusC>
    <Config>$CONFIG</Config>
    <SaveSubspace></SaveSubspace>
    <RunMultiGrid>$RUNMG</RunMultiGrid>
    <Nrhs>1</Nrhs>
    <SolveSingleRHS>0</SolveSingleRHS>
    <Beta>2.13</Beta>
    <TrajL><elem>$TRAJL</elem></TrajL>
    <MDsteps><elem>$MDSTEPS</elem></MDsteps>
    <Ntraj>1</Ntraj>
    <Chain>1</Chain>
    <Mode>$MODE</Mode>
    <SolveEvery>$SOLVEEVERY</SolveEvery>
    <SolveTraj></SolveTraj>
    <RefreshTol>$REFRESHTOL</RefreshTol>
    <RefreshMaxOuter>$REFRESHMAXOUTER</RefreshMaxOuter>
    <RefreshPasses>$REFRESHPASSES</RefreshPasses>
    <RefreshOrthonormalise>$REFRESHORTHO</RefreshOrthonormalise>
    <RefreshKick>$REFRESHKICK</RefreshKick>
    <NoiseBasis>$NOISEBASIS</NoiseBasis>
    <CorrTol>$CORRTOL</CorrTol>
    <CorrMaxRestarts>$CORRMAXRESTARTS</CorrMaxRestarts>
    <CorrNrhs>$CORRNRHS</CorrNrhs>
    <CorrPrecon>$CORRPRECON</CorrPrecon>
    <CorrKrylovNstep>$CORRKRYLOVNSTEP</CorrKrylovNstep>
    <DiagEvery>$DIAGEVERY</DiagEvery>
    <DiagTest>$DIAGTEST</DiagTest>
    <DiagTestRegen>$DIAGTESTREGEN</DiagTestRegen>
    <DiagReference>$DIAGREFERENCE</DiagReference>
    <MultiGrid>
      <Setup>
        <Block1>$(elems "$BLOCK1")</Block1>
        <Block2>$(elems "$BLOCK2")</Block2>
        <CoarsenBatch>9</CoarsenBatch>
        <SubspaceFile>$SAVE</SubspaceFile>
        <FineSloppyComms>1</FineSloppyComms>
        <FinePrecision>fp64</FinePrecision>
        <RetainSubspace>1</RetainSubspace>
      </Setup>
      <FineSmoother>
        <Shift>$FSHIFT</Shift><Nstep>$FNSTEP</Nstep><Mmax>$FMMAX</Mmax>
      </FineSmoother>
      <CoarseSmoother>
        <Shift>$CSHIFT</Shift><Nstep>$CNSTEP</Nstep><Mmax>$CMMAX</Mmax>
      </CoarseSmoother>
      <CoarseSolver>
        <Tol>$CTOL</Tol><Order>$CORDER</Order><Mmax>$CSMMAX</Mmax>
      </CoarseSolver>
      <Outer>
        <Tol>1e-8</Tol><MaxIterations>$OUTERMAXIT</MaxIterations><Mmax>$OMMAX</Mmax><Nstep>$ONSTEP</Nstep>
      </Outer>
      <Dense>
        <LeafSpan>9</LeafSpan>
      </Dense>
    </MultiGrid>
  </QuenchedHMCDriver>
</grid>
EOF
}

start_run () {
  write_params
  echo "=== $PARAMS ==="; cat $PARAMS; echo "=================="
  echo "log $LOG"
  : > $LOG
}
STEPNO=0    # srun step id: the watchdog must cancel the current step, not step 0

run_step () {
  name=$1; bin=$2
  echo "===== STEP $name : $bin =====" >> $LOG
  ls -l --time-style=long-iso $bin >> $LOG
  # Grid prints a failed device allocation and returns NULL instead of
  # aborting, and the job can then hang to the timeout (5839214: 2.8 h on 36
  # nodes).  Cancel the step on the first one.
  ( tail -n0 -F $LOG | grep -q -m1 "hipMalloc failed" \
      && echo "WATCHDOG: hipMalloc failed, cancelling step ${SLURM_JOB_ID}.$STEPNO" >> $LOG \
      && scancel ${SLURM_JOB_ID}.$STEPNO ) &
  WATCH=$!
  timeout $TIMEOUT srun -N36 -n288 --kill-on-bad-exit=1 ./select_gpu $bin --mpi ${MPI_GEOM} --grid $vol $OPTS \
       --hmc-params $PARAMS --log Error,Warning,Message,Performance >> $LOG 2>&1
  rc=$?
  kill $WATCH 2>/dev/null
  echo "===== END STEP $name exit $rc =====" >> $LOG
  python3 $COMPACT $LOG || echo "  compact log failed: python3 $COMPACT $LOG"
  echo "step $name exit $rc"
  sed -n "/===== STEP $name /,/===== END STEP $name /p" $LOG > step.tmp
  if grep -q "Bus error\|Memory access fault\|NO_TRANSLATION\|CANCELLED" step.tmp; then
    echo "  FAULT:"; grep -h "Bus error\|Memory access fault\|NO_TRANSLATION\|CANCELLED" step.tmp | head -5 | cut -c1-160
  fi
  echo "  last setup stage and results:"
  grep -h "QHMC-\|CoarsenOperator, batch\|GUARD\|GALERKIN CERTIFICATE\|dense ||A Ainv\|Nrhs .* total\|FINAL Nrhs.*worst\|Fouter MrhsPGCR: Converged" \
       step.tmp | cut -c1-160
  tail -3 step.tmp | cut -c1-160
  sleep 30
  STEPNO=$((STEPNO+1))
}

if [ -z "$SCAN" ]; then
  start_run
  run_step qhmc $BIN
else
  for entry in ${SCAN//\// }; do
    MODE=${entry%%:*}; TRAJL=${entry#*:}
    LOG=$LOGDIR/MG_QHMC_${SLURM_JOB_ID}_${MODE}_eps${TRAJL}.log
    PARAMS=$LOGDIR/MG_QHMC_${SLURM_JOB_ID}_${MODE}_eps${TRAJL}.params.xml
    start_run
    run_step qhmc $BIN
  done
fi
