#!/bin/bash -l
#SBATCH --job-name=pvdagm-mg-bench
#SBATCH --nodes=36
#SBATCH --ntasks-per-node=8
#SBATCH --cpus-per-task=7
#SBATCH --gpus-per-node=8
#SBATCH --time=0:45:00
#SBATCH --account=phy157_dwf
#SBATCH --gpu-bind=none
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH -S 0
#SBATCH --exclude=frontier06752,frontier02678

##############################################################################
# Frontier PVdagM 3-level benchmark, 48^3x96.  Default tree: the fork
# ~/GridPoare (develop f974dae3), step 0b.  Peter's tree ran clean as
# 5777649 (~/Grid, 3232b438); to rerun it:
#   sbatch --export=ALL,GRIDROOT=/ccs/home/poare/Grid run_pvdagm_multigrid_frontier.job
# --device-mem 32000: at 40000 three jobs (5775582, 5776637, 5777472) each
# lost one node in GPU work; 11.5 GB resident + 39 GB manager cache + comms
# + shm is ~60 GB of 64 per GCD before the Nrhs 12 solve.
#
# Derived from $GRID/systems/Frontier/pvdagm_multigrid.job. Changes from it:
#   - our build and sourceme, not Peter's tree
#   - nothing on Lustre: like the rest of the workflow, the job writes one
#     log, LOGDIR/MG_PVdagM_<jobid>.log, with its params.xml beside it; no
#     --debug-stdout
#   - frontier06752 excluded (5775582: bus error at the first hipBLAS call);
#     frontier02678 excluded (5776637: task 274 there hung and survived kill)
#   - capped at 15 min by timeout; a clean run needs ~5
#   - Peter's subspace is read-only: the job stops if it is not readable,
#     since a missing file makes the driver breed AND SAVE to that path
#   - GRID_ALLOC_NCACHE_LARGE=64, the production value in his progress note
#     (section 11); his job sets 0 deliberately to provoke the fault
#
# Solver settings: Peter's tuned point (MultiGridSummary sections 5-6):
# Outer.Mmax 4 and fine smoother Nstep 10.  At Nrhs 12, Mmax 6 puts ~24.5 GB
# of outer history against the 32 GB manager cache and evicts.
# Reference (all fp64): with Outer.Mmax 6 and smoother Nstep 6, 5777649
# (Peter's tree) gave 14.73 s per RHS at Nrhs 12 and 30.20 s at Nrhs 1,
# 5783429 (fork) 14.58 s and 29.99 s, both 57 outer its; Peter's P0 cell
# (Mmax 4, Nstep 6) 12.16 s and 30.70 s.  Red-black CG: 363 s per RHS.
##############################################################################

# --- edit these two ---
GRIDROOT=${GRIDROOT:-/ccs/home/poare/GridPoare}  # fork by default; --export GRIDROOT=... overrides
BUILD=$GRIDROOT/build-rocm72                     # the build directory configured below

source $GRIDROOT/systems/Frontier/sourceme-rocm7.2.sh

SUBSPACE=/lustre/orion/phy157/proj-shared/phy157_dwf/paboyle/subspace_nb64.scidac
CONFIG=/lustre/orion/phy157/proj-shared/phy157_dwf/paboyle/configs/ckpoint_lat.1000   # ~/ckpoint_lat.1000 links here; check the plaquette against Peter's log
BIN=$BUILD/examples/Example_pvdagm_multigrid
LOGDIR=/ccs/home/poare/lqcd/multigrid/logs/ckpoint_lat.1000

for f in $SUBSPACE $CONFIG $BIN; do
  [ -r $f ] || { echo "NOT READABLE: $f -- stopping"; exit 1; }
done

mkdir -p $LOGDIR
LOG=$LOGDIR/MG_PVdagM_${SLURM_JOB_ID}.log
PARAMS=$LOGDIR/MG_PVdagM_${SLURM_JOB_ID}.params.xml
( cd $GRIDROOT && echo "Grid $(git rev-parse HEAD) $(git status --short | wc -l) modified" )

# Never strip this wrapper: distinct-GCD binding, NUMA locality, SDMA peer copies.
cat << EOF > select_gpu
#!/bin/bash
export GPU_MAP=(0 1 2 3 7 6 5 4)
export NUMA_MAP=(3 3 1 1 2 2 0 0)
export GPU=\${GPU_MAP[\$SLURM_LOCALID]}
export NUMA=\${NUMA_MAP[\$SLURM_LOCALID]}
export HIP_VISIBLE_DEVICES=\$GPU
unset ROCR_VISIBLE_DEVICES
if [ \$SLURM_PROCID = "0" ]; then echo \$*; fi
exec numactl -m \$NUMA -N \$NUMA \$*
EOF
chmod +x ./select_gpu

export OMP_NUM_THREADS=7
ulimit -c 0                             # no 22 GB GPU core dumps
export FI_MR_CACHE_MONITOR=kdreg2
export FI_HMEM_ROCR_USE_DMABUF=0        # avoidance of the CXI NO_TRANSLATION fault at Nrhs >= 12
export MPICH_GPU_SUPPORT_ENABLED=1
export MPICH_SMP_SINGLE_COPY_MODE=CMA
export MPICH_OFI_NIC_POLICY=GPU
export GRID_ALLOC_NCACHE_LARGE=64

module load libfabric

OPTS="--accelerator-threads 8 --shm 4096 --shm-mpi 0 --device-mem 32000 --comms-overlap"
vol=48.48.48.96
MPI_GEOM=3.6.4.4

# Peter's banked operating point, verbatim. A mistyped tag silently
# deserialises to the struct default, so keep this in step with
# PVdagMMultiGridParams.h.
cat << EOF > $PARAMS
<?xml version="1.0"?>
<grid>
  <PVdagMDriver>
    <Ls>24</Ls>
    <Mass>0.00078</Mass>
    <M5>1.8</M5>
    <MobiusB>1.5</MobiusB>
    <MobiusC>0.5</MobiusC>
    <Config>$CONFIG</Config>
    <Nrhs>12</Nrhs>
    <SolveSingleRHS>1</SolveSingleRHS>
    <MultiGrid>
      <Setup>
        <Block1><elem>2</elem><elem>2</elem><elem>3</elem><elem>3</elem></Block1>
        <Block2><elem>4</elem><elem>4</elem><elem>2</elem><elem>4</elem></Block2>
        <CoarsenBatch>9</CoarsenBatch>
        <SubspaceFile>$SUBSPACE</SubspaceFile>
        <FineSloppyComms>1</FineSloppyComms>
        <FinePrecision>fp64</FinePrecision>
        <RetainSubspace>0</RetainSubspace>
      </Setup>
      <FineSmoother>
        <Shift>0.1</Shift><Nstep>10</Nstep><Mmax>4</Mmax>
      </FineSmoother>
      <CoarseSmoother>
        <Shift>2.0</Shift><Nstep>2</Nstep><Mmax>2</Mmax>
      </CoarseSmoother>
      <CoarseSolver>
        <Tol>0.05</Tol><Order>200</Order><Mmax>8</Mmax>
      </CoarseSolver>
      <Outer>
        <Tol>1e-8</Tol><MaxIterations>1000</MaxIterations><Mmax>4</Mmax><Nstep>12</Nstep>
      </Outer>
      <Dense>
        <LeafSpan>9</LeafSpan>
      </Dense>
    </MultiGrid>
  </PVdagMDriver>
</grid>
EOF
echo "=== $PARAMS ==="; cat $PARAMS; echo "=================="

echo "log $LOG"
: > $LOG

run_step () {
  name=$1; bin=$2
  echo "===== STEP $name : $bin =====" >> $LOG
  ls -l --time-style=long-iso $bin >> $LOG
  timeout 15m srun -N36 -n288 --kill-on-bad-exit=1 ./select_gpu $bin --mpi ${MPI_GEOM} --grid $vol $OPTS \
       --pvdagm-params $PARAMS --log Error,Warning,Message,Performance >> $LOG 2>&1
  rc=$?
  echo "===== END STEP $name exit $rc =====" >> $LOG
  echo "step $name exit $rc"
  sed -n "/===== STEP $name /,/===== END STEP $name /p" $LOG > step.tmp
  if grep -q "Bus error\|Memory access fault\|NO_TRANSLATION\|CANCELLED" step.tmp; then
    echo "  FAULT:"; grep -h "Bus error\|Memory access fault\|NO_TRANSLATION\|CANCELLED" step.tmp | head -5 | cut -c1-160
  fi
  echo "  last setup stage and results:"
  grep -h "CoarsenOperator, batch\|GUARD\|GALERKIN CERTIFICATE\|dense ||A Ainv\|Nrhs .* total\|FINAL Nrhs.*worst\|Fouter MrhsPGCR: Converged" \
       step.tmp | cut -c1-160
  tail -3 step.tmp | cut -c1-160
  sleep 30
}

run_step ours $BIN
