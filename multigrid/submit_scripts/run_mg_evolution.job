#!/bin/bash

##ulimit -c unlimited

#SBATCH --job-name=mg_evolution
#SBATCH --nodes=8
#SBATCH --ntasks-per-node=1
##SBATCH --partition=lqcd
##SBATCH --account=class-c-arnoldi
#SBATCH --partition=riken
#SBATCH -q riken
#SBATCH --account=rbrcgeneral
#SBATCH -t 03:00:00

# Evolution of the MG near-null subspace across HMC trajectories: block-span
# capture of a re-bred basis by the frozen, refined and previous bases, plus
# MG solves for (b) recoarsen, (c) refine, (d) fresh. nbasis and beta are
# compiled in; MDsteps defaults to 80*trajL (at least 4).
#
# The trajectory length comes from the environment, so a sweep differs only
# on the command line:
#   sbatch --export=ALL,trajL=0.01 run_mg_evolution.job
# Without it, trajL defaults to 1.0. 424581 (trajL=1, 10 trajectories) took
# 82 min on 8 nodes. MD steps can be set the same way to tune acceptance:
#   sbatch --export=ALL,trajL=1.0,mdsteps=40 run_mg_evolution.job

trajL=${trajL:-1.0}
mdsteps=${mdsteps:-}     # empty: binary default max(4, round(80*trajL))

nodes=8
nproc=8
MPIRUN='srun -N'${nodes}' -n'${nproc}

root="ckpoint_lat.4000"
runname="MG_evolution_trajL${trajL}${mdsteps:+_md${mdsteps}}_${SLURM_JOB_ID}"

homedir=/sdcc/u/poare
inFile="${homedir}/PETSc-Grid/ckpoint_lat.4000"

logDir="${homedir}/lqcd/multigrid/logs/${root}"
mkdir -p ${logDir}
logs="${logDir}/${runname}.log"

cd ${homedir}/Grid/build/examples

mpigrid=2.2.2.1
OPT='  --shm-mpi 0 --shm 16384  --comms-overlap --comms-concurrent --dslash-asm '

export OMP_NUM_THREADS=64
export OMP_PLACES=cores
export OMP_PROC_BIND=close

module load openmpi

$MPIRUN ./Example_mg_evolution --config ${inFile} --trajL ${trajL} ${mdsteps:+--mdsteps ${mdsteps}} --budget-hours 2.75 --mpi ${mpigrid} ${OPT} > ${logs}

# One line per trajectory for plotting:
#   grep MGEVO ${logs}
