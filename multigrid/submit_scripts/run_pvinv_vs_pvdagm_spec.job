#!/bin/bash

#SBATCH --job-name=pvinv_vs_pvdag
#SBATCH --nodes=8
#SBATCH --ntasks-per-node=1
#SBATCH --partition=riken
#SBATCH -q riken
#SBATCH --account=rbrcgeneral
#SBATCH -t 24:00:00

nodes=8
nproc=8
MPIRUN='srun -N8 -n'${nproc}

Nm=80
Nk=40
maxIter=10000
Nstop=30
rf="EvalNormSmall"

root="ckpoint_lat.4000"
runname="PVinv_vs_PVdagM_Ls16_m0.1_Nm${Nm}_Nk${Nk}_${SLURM_JOB_ID}"

homedir=/sdcc/u/poare
inFile="${homedir}/PETSc-Grid/ckpoint_lat.4000"

logDir="${homedir}/lqcd/multigrid/logs/${root}"
outDir="${homedir}/lqcd/multigrid/spectra/${root}/${runname}"
mkdir -p ${logDir}
mkdir -p ${outDir}
logs="${logDir}/${runname}.log"

cd ${homedir}/Grid/build/examples

mpigrid=2.2.2.1
vol=16.16.16.32

OPT='  --shm-mpi 0 --shm 16384  --comms-overlap --comms-concurrent --dslash-asm '
OPT2='  --auto-tune --verbose_add cg_performance '

export OMP_NUM_THREADS=64
export OMP_PLACES=0:64:1

module load openmpi

$MPIRUN ./Example_pvinv_vs_pvdagm_spec ${Nm} ${Nk} ${maxIter} ${Nstop} ${inFile} ${outDir} ${rf} --mpi ${mpigrid} --grid ${vol} --Ls 16 --mass 0.1 ${OPT} ${OPT2} > ${logs}
